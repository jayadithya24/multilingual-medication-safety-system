# Backend MongoDB and authentication settings
MONGO_URI=
MONGO_DB=meds

# Firebase Admin service account JSON. Keep this secret and do not commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
REMINDER_TIMEZONE=Asia/Kolkata
REMINDER_POLL_SECONDS=30

# Generate a private random signing key (at least 32 characters).
JWT_SECRET_KEY=
# Google OAuth Web application client ID. No client secret is needed.
GOOGLE_CLIENT_ID=
