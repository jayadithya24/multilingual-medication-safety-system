# Backend MongoDB and authentication settings
MONGO_URI=
MONGO_DB=meds

# Firebase Admin service account JSON. Keep this secret and do not commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively, use an absolute path to a private service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_FILE=
REMINDER_TIMEZONE=Asia/Kolkata
REMINDER_POLL_SECONDS=2
REMINDER_CATCHUP_MINUTES=5

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
WARM_UP_OCR=true

# Google OAuth Web application client ID. No client secret is needed.
GOOGLE_CLIENT_ID=
BROWSER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Production requires HTTPS cookies. Local HTTP loopback is development only.
ENVIRONMENT=development
# Research endpoints are disabled in the product by default.
ENABLE_RESEARCH_ML_API=false
# Production always uses shared MongoDB counters; opt in during local verification.
RATE_LIMIT_BACKEND=memory
